{
  "name": "glyphflow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser-based handwritten TrueType font editor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "node scripts/check.mjs",
    "unicode:catalog": "node scripts/update-unicode-catalog.mjs 18.0.0",
    "unicode:catalog:test": "node scripts/unicode-catalog-parser-test.mjs",
    "unicode:catalog:validate": "node scripts/validate-unicode-catalog.mjs 18.0.0",
    "prebuild": "node scripts/prepare-unicode-catalog.mjs",
    "unicode:metadata:test": "node scripts/glyph-metadata-test.mjs",
    "font:package": "node scripts/pack-font-release.mjs",
    "font:package:test": "node scripts/pack-font-release-test.mjs",
    "kerning:test": "node scripts/kerning-test.mjs",
    "gpos:test": "node scripts/gpos-test.mjs"
  },
  "dependencies": {
    "fonteditor-core": "2.6.3",
    "opentype.js": "1.3.4",
    "perfect-freehand": "1.2.0",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "tailwindcss": "3.4.17",
    "vite": "6.4.6"
