{
  "name": "glyphflow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Browser-based handwritten TrueType font editor",
  "scripts": {
    "dev": "vite",
    "build": "tailwindcss -i ./src/styles.css -o ./public/styles.css --minify && vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "fonteditor-core": "2.6.3",
    "opentype.js": "1.3.4",
    "perfect-freehand": "1.2.0",
    "polygon-clipping": "0.15.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "tailwindcss": "3.4.17",
    "vite": "6.4.1"
  }
}